# Azure Storage (for upload_blob.py / download_data.py)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=azureml
LOCAL_PATH=data

# Azure ML Workspace (for submit_pipeline.py)
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_WORKSPACE_NAME=your_workspace_name
COMPUTE_NAME=your_compute_cluster_name

# Blob Storage for dataset
BLOB_ACCOUNT_NAME=your_blob_account_name
BLOB_CONTAINER_NAME=datasets
BLOB_ACCOUNT_KEY=your_blob_account_key
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Azure ML Datastore
DATASTORE_NAME=pothole_detection
DATASET_FOLDER=azureml
